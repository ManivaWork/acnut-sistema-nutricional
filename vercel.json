{
  "buildCommand": "cd frontend/interface && npm run build",
  "installCommand": "cd frontend/interface && npm install",
  "outputDirectory": "frontend",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/interface/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/definir-senha/:token",
      "destination": "/interface/index.html"
    },
    {
      "source": "/convite/:token",
      "destination": "/interface/index.html"
    },
    {
      "source": "/convite-paciente/:token",
      "destination": "/interface/index.html"
    }
  ]
}