@baseUrl = http://localhost:5000
@tokenB = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Token do usuário da empresa B
@pacienteA = 1        # ID de paciente da empresa A
@refeicaoA = 1        # ID de refeição da empresa A
@itemA = 1            # ID de item da empresa A
@metaA = 1            # ID de meta da empresa A
@exameA = 1           # ID de exame da empresa A
